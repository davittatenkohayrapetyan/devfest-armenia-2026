# Absolute origin for Open Graph tags and sitemap.xml. Must be the real domain before
# deploying: npm run build:deploy refuses to run while this is localhost.
VITE_SITE_URL=https://devfest.am/2026

# Derived from VITE_SITE_URL by build:deploy — /2026/ in production (ADR-011).
# Only set this by hand to override; the local container serves at the root.
VITE_BASE_PATH=/

# Set once the 2026 Sessionize embed ID is known (NOT the CFP slug)
VITE_SESSIONIZE_EMBED_ID=

# Optional forms
VITE_PARTNER_FORM_URL=
VITE_VOLUNTEER_FORM_URL=

# Analytics (ADR-012). Cookieless and aggregate — no consent banner required.
# Unset means no script tag is emitted at all, which is what local builds want.
# The outbound-links variant is used so Register and Submit-a-talk clicks are counted.
VITE_ANALYTICS_DOMAIN=devfest.am
# Override only when self-hosting (e.g. Umami); defaults to Plausible.
# VITE_ANALYTICS_SRC=
