# Absolute origin for Open Graph tags and sitemap.xml. Must be the real domain before
# deploying: npm run build:deploy refuses to run while this is localhost.
VITE_SITE_URL=https://example.com

# Root deploy by default. For a WordPress subfolder use e.g. /devfest2026/
VITE_BASE_PATH=/

# Set once the 2026 Sessionize embed ID is known (NOT the CFP slug)
VITE_SESSIONIZE_EMBED_ID=

# Optional forms
VITE_PARTNER_FORM_URL=
VITE_VOLUNTEER_FORM_URL=
